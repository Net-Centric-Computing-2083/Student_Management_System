@model List<StudentManagementSystem.Models.Assignment>

@{
    ViewData["Title"] = "My Assignments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="fw-bold">My Assignments</h1>
        <a asp-action="Create" class="btn btn-primary">+ New Assignment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">You haven't created any assignments yet.</div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Course</th>
                        <th>Due Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var overdue = a.DueDate < DateTime.Now;
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Course?.CourseName</td>
                            <td>
                                @a.DueDate.ToString("MMM dd, yyyy h:mm tt")
                                @if (overdue)
                                {
                                    <span class="badge bg-secondary ms-1">Closed</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-action="Submissions" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-secondary">Submissions</a>
                                <a asp-action="Edit" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
