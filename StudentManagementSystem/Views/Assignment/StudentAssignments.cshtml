@model List<StudentManagementSystem.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
    var submittedIds = ViewBag.SubmittedAssignmentIds as List<int> ?? new();
}

<div class="container mt-4">
    <h1 class="fw-bold">Assignments</h1>
    <p class="text-muted">Assignments for your enrolled courses.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No assignments have been posted for your courses yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Course</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var submitted = submittedIds.Contains(a.AssignmentId);
                        var overdue = !submitted && a.DueDate < DateTime.Now;
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Course?.CourseName</td>
                            <td>@a.DueDate.ToString("MMM dd, yyyy h:mm tt")</td>
                            <td>
                                @if (submitted)
                                {
                                    <span class="badge bg-success">Submitted</span>
                                }
                                else if (overdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-action="StudentDetails" asp-route-id="@a.AssignmentId"
                                   class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
