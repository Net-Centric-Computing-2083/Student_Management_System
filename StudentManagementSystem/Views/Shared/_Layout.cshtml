<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar desktop-only d-none d-md-flex flex-md-column">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">Student Management System</a>
            @await Html.PartialAsync("_SidebarNav")
        </aside>

        <div class="app-main">
            <nav class="app-topbar navbar navbar-light d-flex align-items-center">
                <button class="sidebar-toggle-btn d-md-none me-2" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    &#9776;
                </button>
                <a class="navbar-brand fw-bold d-md-none mb-0" asp-controller="Home" asp-action="Index">SMS</a>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="text-muted small">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-none d-md-block">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                    </form>
                </div>
            </nav>

            <main class="app-content container-fluid py-4">
                @if (TempData["DeleteError"] != null) { <div class="alert alert-danger">@TempData["DeleteError"]</div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
                @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
                @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted"><div class="container-fluid py-3">&copy; 2026 - Student Management System</div></footer>
        </div>
    </div>

    <!-- Mobile sidebar (offcanvas) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            @await Html.PartialAsync("_SidebarNav")
        </div>
    </div>
}
else
{
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Student Management System</a>
                <div class="d-flex ms-auto">
                    <a class="btn btn-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-link" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4">
        @if (TempData["DeleteError"] != null) { <div class="alert alert-danger">@TempData["DeleteError"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted"><div class="container py-3">&copy; 2026 - Student Management System</div></footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
