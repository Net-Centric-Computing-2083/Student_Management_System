@model StudentManagementSystem.Models.Enrollment
@{ ViewData["Title"] = "Edit Enrollment"; }

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header"><h3 class="mb-0">Edit Enrollment</h3></div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="EnrollmentId" />
                <div class="mb-3">
                    <label asp-for="StudentId" class="form-label"></label>
                    <select asp-for="StudentId" asp-items="ViewBag.StudentId" class="form-select"></select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label"></label>
                    <select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-select"></select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SemesterId" class="form-label"></label>
                    <select asp-for="SemesterId" asp-items="ViewBag.SemesterId" class="form-select"></select>
                    <span asp-validation-for="SemesterId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EnrollmentDate" class="form-label"></label>
                    <input asp-for="EnrollmentDate" type="date" class="form-control" />
                    <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option>Active</option><option>Completed</option><option>Cancelled</option>
                    </select>
                </div>
                <button class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </form>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
