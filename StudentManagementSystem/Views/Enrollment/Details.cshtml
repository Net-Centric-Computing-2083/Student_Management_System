@model StudentManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<h1>Enrollment Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Student
    </dt>
    <dd class="col-sm-9">
        @Model.Student?.Name
    </dd>

    <dt class="col-sm-3">
        Course
    </dt>
    <dd class="col-sm-9">
        @Model.Course?.CourseName
    </dd>

    <dt class="col-sm-3">
        Enrollment Date
    </dt>
    <dd class="col-sm-9">
        @Model.EnrollmentDate.ToString("yyyy-MM-dd")
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>
    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.EnrollmentId"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>