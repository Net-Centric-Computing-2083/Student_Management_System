@model IEnumerable<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Student Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Student Management</h2>
            <p class="text-muted mb-0">Manage all student records</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Student
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-5">
                        <label class="form-label">Search</label>

                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentSearch"]"
                               class="form-control"
                               placeholder="Name, Email, Phone or Reg. No." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Department</label>

                        <select name="departmentId"
                                asp-items="ViewBag.Departments"
                                class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label d-block">&nbsp;</label>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Student Table -->
    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>

                        <th>Photo</th>

                        <th>Reg. No.</th>

                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSort"]"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-departmentId="@ViewData["CurrentDepartment"]"
                               class="text-white text-decoration-none">
                                Name ↕
                            </a>
                        </th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Department</th>

                        <th>Enrollment</th>

                        <th class="text-center">Actions</th>

                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No students found.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- Student Photo -->
                            <td>
                                @if (!string.IsNullOrEmpty(item.PhotoPath))
                                {
                                    <img src="~/uploads/students/@item.PhotoPath"
                                         width="45"
                                         height="45"
                                         class="rounded-circle border"
                                         style="object-fit:cover;" />
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/45"
                                         width="45"
                                         height="45"
                                         class="rounded-circle border" />
                                }
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @item.RegistrationNumber
                                </span>
                            </td>

                            <td class="fw-semibold">
                                @item.Name
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @item.Phone
                            </td>

                            <td>
                                @item.Department?.DepartmentName
                            </td>

                            <td>
                                @item.EnrollmentYear
                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.StudentId"
                                   class="btn btn-info btn-sm text-white">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.StudentId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.StudentId"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Pagination -->
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">
                        Next
                    </a>
                </li>
            }

        </ul>

    </nav>

</div>