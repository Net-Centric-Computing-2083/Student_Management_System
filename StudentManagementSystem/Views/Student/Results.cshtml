@model IEnumerable<StudentManagementSystem.Models.Result>
@{ ViewData["Title"] = "My Results"; }
<div class="container mt-4">
    <h2>My Results</h2>
    <p class="text-muted">Only results belonging to your logged-in student profile are shown.</p>
    @if (!Model.Any()) { <div class="alert alert-info">No results are available yet.</div> }
    else { <div class="table-responsive"><table class="table table-hover"><thead class="table-dark"><tr><th>Course</th><th>Internal</th><th>Practical</th><th>Final</th><th>Total</th><th>Grade</th><th>GPA</th><th>Date</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Course?.CourseName</td><td>@r.InternalMarks</td><td>@r.PracticalMarks</td><td>@r.FinalMarks</td><td>@r.TotalMarks</td><td><span class="badge bg-primary">@r.Grade</span></td><td>@r.GPA.ToString("0.00")</td><td>@r.ResultDate.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div> }
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>
