@model StudentManagementSystem.ViewModels.AcademicProgressViewModel

@{
    ViewData["Title"] = "Academic Progress";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Academic Progress
        </h1>

        <p class="lead text-muted">
            Track your academic performance, grades, GPA, and course progress.
        </p>

    </div>


    <!-- STUDENT INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h4 class="fw-bold mb-1">
                        @Model.Student.Name
                    </h4>

                    <p class="text-muted mb-1">

                        Registration Number:

                        <strong>
                            @Model.Student.RegistrationNumber
                        </strong>

                    </p>

                    <p class="text-muted mb-0">

                        Department:

                        <strong>
                            @(Model.Student.Department?.DepartmentName ?? "N/A")
                        </strong>

                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <span class="badge bg-primary fs-6 px-3 py-2">
                        Academic Progress
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">


        <!-- OVERALL GPA -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Overall GPA
                    </h6>

                    <h2 class="fw-bold text-primary mb-0">
                        @Model.OverallGPA.ToString("0.00")
                    </h2>

                    <small class="text-muted">
                        Based on available results
                    </small>

                </div>

            </div>

        </div>


        <!-- AVERAGE MARKS -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Average Marks
                    </h6>

                    <h2 class="fw-bold text-success mb-0">
                        @Model.AverageMarks.ToString("0.00")
                    </h2>

                    <small class="text-muted">
                        Out of 100
                    </small>

                </div>

            </div>

        </div>


        <!-- TOTAL COURSES -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Courses
                    </h6>

                    <h2 class="fw-bold text-info mb-0">
                        @Model.TotalCourses
                    </h2>

                    <small class="text-muted">
                        Enrolled courses
                    </small>

                </div>

            </div>

        </div>


        <!-- PASSED COURSES -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Passed Courses
                    </h6>

                    <h2 class="fw-bold text-warning mb-0">
                        @Model.PassedCourses
                    </h2>

                    <small class="text-muted">
                        Courses with passing grade
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- COURSE PROGRESS TABLE -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Course-wise Academic Progress
            </h4>

        </div>


        <div class="card-body p-0">

            @if (Model.Courses.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Course</th>

                                <th>Code</th>

                                <th>Credit Hours</th>

                                <th>Semester</th>

                                <th>Academic Year</th>

                                <th>Total Marks</th>

                                <th>Grade</th>

                                <th>GPA</th>

                                <th>Status</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var course in Model.Courses)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @course.CourseName
                                    </td>

                                    <td>
                                        @course.CourseCode
                                    </td>

                                    <td>
                                        @course.CreditHours
                                    </td>

                                    <td>
                                        @course.SemesterName
                                    </td>

                                    <td>
                                        @course.AcademicYear
                                    </td>

                                    <td>
                                        @course.TotalMarks.ToString("0.##")
                                    </td>

                                    <td>

                                        @if (course.HasResult)
                                        {
                                            <span class="badge bg-primary">
                                                @course.Grade
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not Available
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (course.HasResult)
                                        {
                                            <strong>
                                                @course.GPA.ToString("0.00")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (!course.HasResult)
                                        {
                                            <span class="badge bg-secondary">
                                                Result Pending
                                            </span>
                                        }
                                        else if (course.GPA > 0)
                                        {
                                            <span class="badge bg-success">
                                                Passed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Not Passed
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-5 text-center">

                    <h5 class="fw-bold">
                        No academic records found
                    </h5>

                    <p class="text-muted mb-0">
                        Your enrolled courses and results will
                        appear here once they are available.
                    </p>

                </div>
            }

        </div>

    </div>

</div>