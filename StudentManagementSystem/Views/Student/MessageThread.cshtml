@model StudentManagementSystem.Models.ContactMessage

@{
    ViewData["Title"] = "Message";
}

<div class="container mt-4">
    <a asp-action="ContactTeacher" class="btn btn-sm btn-outline-secondary mb-3">&laquo; Back to Messages</a>

    <div class="card shadow-sm mb-3">
        <div class="card-header">
            <strong>@Model.Subject</strong>
            <span class="badge @(Model.Status == "New" ? "bg-warning text-dark" : "bg-success") float-end">@Model.Status</span>
        </div>
        <div class="card-body">
            <p class="text-muted mb-1">
                To: @Model.Teacher?.Name
                @if (Model.Course != null)
                {
                    <span> &middot; @Model.Course.CourseName</span>
                }
            </p>
            <p class="text-muted small">Sent @Model.SentDate.ToString("MMM dd, yyyy h:mm tt")</p>
            <p style="white-space: pre-wrap;">@Model.MessageText</p>
        </div>
    </div>

    @foreach (var reply in Model.Replies.OrderBy(r => r.SentDate))
    {
        <div class="card shadow-sm mb-3 @(reply.SenderRole == "Teacher" ? "border-primary" : "")">
            <div class="card-header">
                <strong>@(reply.SenderRole == "Teacher" ? Model.Teacher?.Name : "You")</strong>
                <span class="text-muted small float-end">@reply.SentDate.ToString("MMM dd, yyyy h:mm tt")</span>
            </div>
            <div class="card-body">
                <p style="white-space: pre-wrap;" class="mb-0">@reply.MessageText</p>
            </div>
        </div>
    }
</div>
