@model StudentManagementSystem.Models.Announcement

@{
    ViewData["Title"] = "Announcement";
}

<div class="container mt-4">
    <a asp-action="Announcements" class="btn btn-sm btn-outline-secondary mb-3">&laquo; Back to Announcements</a>

    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="fw-bold">@Model.Title</h3>
            <p class="text-muted mb-3">
                Posted by @Model.AuthorName on @Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")
                @if (Model.Scope == "Course" && Model.Course != null)
                {
                    <span> &middot; Course: @Model.Course.CourseName</span>
                }
            </p>
            <p style="white-space: pre-wrap;">@Model.Content</p>
        </div>
    </div>
</div>
