@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<h3>Are you sure you want to delete this student?</h3>
<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Student ID
        </dt>
        <dd class="col-sm-9">
            @Model.StudentId
        </dd>

        <dt class="col-sm-3">
            Full Name
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3">
            Email Address
        </dt>
        <dd class="col-sm-9">
            @Model.Email
        </dd>

        <dt class="col-sm-3">
            Phone Number
        </dt>
        <dd class="col-sm-9">
            @Model.Phone
        </dd>

        <dt class="col-sm-3">
            Address
        </dt>
        <dd class="col-sm-9">
            @Model.Address
        </dd>

        <dt class="col-sm-3">
            Gender
        </dt>
        <dd class="col-sm-9">
            @Model.Gender
        </dd>

        <dt class="col-sm-3">
            Date of Birth
        </dt>
        <dd class="col-sm-9">
            @Model.DateOfBirth.ToString("yyyy-MM-dd")
        </dd>

        <dt class="col-sm-3">
            Department
        </dt>
        <dd class="col-sm-9">
            @Model.Department?.DepartmentName
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="StudentId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>