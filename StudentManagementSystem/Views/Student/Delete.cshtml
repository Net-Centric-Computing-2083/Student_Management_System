@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>

        <h1>Delete Student?</h1>

        <p class="delete-warning">
            Are you sure you want to delete this student?
            This action cannot be undone.
        </p>

        <div class="delete-student-info">

            <div class="large-avatar">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>

            <div>
                <h3>@Model.Name</h3>
                <p>@Model.Email</p>
                <span>Student ID: #@Model.StudentId</span>
            </div>

        </div>

        <div class="delete-details">

            <div>
                <span>Phone</span>
                <strong>@Model.Phone</strong>
            </div>

            <div>
                <span>Gender</span>
                <strong>@Model.Gender</strong>
            </div>

        </div>

        <form asp-action="Delete"
      onsubmit="return confirm('Are you sure you want to delete this student?');">

            <input type="hidden" asp-for="StudentId" />

            <div class="delete-actions">

                <a asp-action="Index"
                   class="btn-secondary-custom">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-danger-confirm">
                    🗑 Yes, Delete Student
                </button>

            </div>

        </form>

    </div>

</div>