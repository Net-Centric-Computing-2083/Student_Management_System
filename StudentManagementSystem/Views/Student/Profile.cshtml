@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h1>My Profile</h1>

    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="~/uploads/students/@Model.PhotoPath" alt="Student photo"
                         class="rounded-circle border" width="120" height="120" style="object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle border d-inline-flex align-items-center justify-content-center text-muted"
                         style="width:120px;height:120px;">No Photo</div>
                }
            </div>

            <h4>Personal Information</h4>

            <dl class="row mt-3">

                <dt class="col-sm-4">
                    Registration Number
                </dt>

                <dd class="col-sm-8">
                    @Model.RegistrationNumber
                </dd>


                <dt class="col-sm-4">
                    Full Name
                </dt>

                <dd class="col-sm-8">
                    @Model.Name
                </dd>


                <dt class="col-sm-4">
                    Email Address
                </dt>

                <dd class="col-sm-8">
                    @Model.Email
                </dd>


                <dt class="col-sm-4">
                    Phone Number
                </dt>

                <dd class="col-sm-8">
                    @Model.Phone
                </dd>


                <dt class="col-sm-4">
                    Gender
                </dt>

                <dd class="col-sm-8">
                    @Model.Gender
                </dd>


                <dt class="col-sm-4">
                    Date of Birth
                </dt>

                <dd class="col-sm-8">
                    @Model.DateOfBirth.ToString("yyyy-MM-dd")
                </dd>


                <dt class="col-sm-4">
                    Address
                </dt>

                <dd class="col-sm-8">
                    @Model.Address
                </dd>


                <dt class="col-sm-4">
                    Enrollment Year
                </dt>

                <dd class="col-sm-8">
                    @Model.EnrollmentYear
                </dd>


                <dt class="col-sm-4">
                    Department
                </dt>

                <dd class="col-sm-8">
                    @Model.Department?.DepartmentName
                </dd>

            </dl>

        </div>
    </div>

    <div class="mt-3">

        <a asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>