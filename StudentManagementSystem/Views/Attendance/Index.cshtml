@model StudentManagementSystem.Models.AttendanceMarkingViewModel
@{ ViewData["Title"] = "Mark Attendance"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <div><h2>Mark Attendance</h2><p class="text-muted">Select a course, semester and date, then mark present students.</p></div>
        <a asp-action="Create" class="btn btn-outline-primary">Add Single Record</a>
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="CourseId" class="form-label">Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"><option value="0">-- Select Course --</option></select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SemesterId" class="form-label">Semester</label>
                <select asp-for="SemesterId" asp-items="ViewBag.Semesters" class="form-select"><option value="0">-- Select Semester --</option></select>
                <span asp-validation-for="SemesterId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AttendanceDate" class="form-label"></label>
                <input asp-for="AttendanceDate" type="date" class="form-control" />
                <span asp-validation-for="AttendanceDate" class="text-danger"></span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark"><tr><th>#</th><th>Student</th><th class="text-center">Present</th></tr></thead>
                <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)
                            <input type="hidden" asp-for="Students[i].StudentId" />
                            <input type="hidden" asp-for="Students[i].StudentName" />
                        </td>
                        <td>@Model.Students[i].StudentName</td>
                        <td class="text-center"><input asp-for="Students[i].IsPresent" class="form-check-input" style="width:20px;height:20px;" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Students.Count > 0)
        {
            <button class="btn btn-primary">Save Attendance</button>
        }
        else
        {
            <div class="alert alert-warning">No students found.</div>
        }
        <a asp-action="History" class="btn btn-secondary">View History</a>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
