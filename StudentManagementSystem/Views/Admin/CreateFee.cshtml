@model StudentManagementSystem.Models.Fee
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "New Fee Record";
}

<div class="container mt-4">
    <h1 class="fw-bold">New Fee Record</h1>

    <form asp-action="CreateFee"
          method="post"
          style="max-width:600px;">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="StudentId" class="form-label">Student</label>

            <select asp-for="StudentId"
                    asp-items="@(ViewData["StudentId"] as SelectList)"
                    class="form-select">

                <option value="">-- Select a student --</option>
            </select>

            <span asp-validation-for="StudentId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SemesterId" class="form-label">Semester</label>

            <select asp-for="SemesterId"
                    asp-items="@(ViewData["SemesterId"] as SelectList)"
                    class="form-select">

                <option value="">-- Select a semester --</option>
            </select>

            <span asp-validation-for="SemesterId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TotalAmount"
                   class="form-label">
                Total Fee Amount
            </label>

            <input asp-for="TotalAmount"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="TotalAmount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DueDate"
                   class="form-label">
                Due Date
            </label>

            <input asp-for="DueDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="DueDate"
                  class="text-danger"></span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Create
        </button>

        <a asp-action="Fees"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}