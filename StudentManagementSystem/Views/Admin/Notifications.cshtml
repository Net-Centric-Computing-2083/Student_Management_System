@model List<StudentManagementSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="fw-bold">Notifications</h1>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllNotificationsRead" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all as read</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no notifications.</div>
    }
    else
    {
        <div class="list-group mt-3">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "" : "list-group-item-light border-start border-4 border-primary")">
                    <div>
                        <div class="fw-semibold">
                            @n.Title
                            @if (!string.IsNullOrEmpty(n.Type))
                            {
                                <span class="badge bg-secondary ms-1">@n.Type</span>
                            }
                        </div>
                        <div>@n.Message</div>
                        <small class="text-muted">@n.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</small>
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkNotificationRead" asp-route-id="@n.NotificationId" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark read</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
