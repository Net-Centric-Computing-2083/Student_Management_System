@model StudentManagementSystem.Models.Fee

@{
    ViewData["Title"] = "Fee Details";
}

<div class="container mt-4">
    <a asp-action="Fees" class="btn btn-sm btn-outline-secondary mb-3">&laquo; Back to Fees</a>

    <div class="card shadow-sm mb-4" style="max-width:600px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Student</dt>
                <dd class="col-sm-8">@Model.Student?.Name</dd>

                <dt class="col-sm-4">Semester</dt>
                <dd class="col-sm-8">@Model.Semester?.SemesterName (@Model.Semester?.AcademicYear)</dd>

                <dt class="col-sm-4">Total Fee</dt>
                <dd class="col-sm-8">@Model.TotalAmount.ToString("N2")</dd>

                <dt class="col-sm-4">Paid</dt>
                <dd class="col-sm-8">@Model.PaidAmount.ToString("N2")</dd>

                <dt class="col-sm-4">Balance</dt>
                <dd class="col-sm-8 fw-bold @(Model.RemainingBalance > 0 ? "text-danger" : "text-success")">
                    @Model.RemainingBalance.ToString("N2")
                </dd>

                <dt class="col-sm-4">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("MMM dd, yyyy")</dd>
            </dl>
        </div>
    </div>

    <h5 class="fw-bold">Payment History</h5>
    @if (!Model.Payments.Any())
    {
        <p class="text-muted">No payments recorded yet.</p>
    }
    else
    {
        <table class="table table-sm mb-4">
            <thead class="table-light">
                <tr><th>Date</th><th>Amount</th><th>Method</th><th>Reference</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate))
                {
                    <tr>
                        <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                        <td>@p.AmountPaid.ToString("N2")</td>
                        <td>@p.PaymentMethod</td>
                        <td>@p.ReferenceNumber</td>
                        <td>@p.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.RemainingBalance > 0)
    {
        <div class="card shadow-sm" style="max-width:500px;">
            <div class="card-header fw-bold">Record a Payment</div>
            <div class="card-body">
                <form asp-action="RecordPayment" method="post">
                    <input type="hidden" name="feeId" value="@Model.FeeId" />
                    <div class="mb-3">
                        <label class="form-label">Amount Paid</label>
                        <input name="AmountPaid" type="number" step="0.01" min="0.01" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select name="PaymentMethod" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Card">Card</option>
                            <option value="Mobile Wallet">Mobile Wallet</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reference / Receipt No.</label>
                        <input name="ReferenceNumber" type="text" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Record Payment</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success" style="max-width:500px;">This fee has been paid in full.</div>
    }
</div>
