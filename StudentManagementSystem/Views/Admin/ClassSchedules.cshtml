@model IEnumerable<StudentManagementSystem.Models.ClassSchedule>

@{
    ViewData["Title"] = "Class Schedules";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Class Schedules</h1>
            <p class="text-muted mb-0">
                Manage course, teacher, semester and class schedules.
            </p>
        </div>

        <a asp-action="CreateClassSchedule"
           class="btn btn-primary">
            + Create Class Schedule
        </a>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="ClassSchedules"
                  method="get">

                <div class="row g-3">

                    <!-- Teacher -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Teacher
                        </label>

                        <select name="teacherId"
                                class="form-select"
                                asp-items="ViewBag.Teachers">
                            <option value="">-- All Teachers --</option>
                        </select>
                    </div>

                    <!-- Course -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Course
                        </label>

                        <select name="courseId"
                                class="form-select"
                                asp-items="ViewBag.Courses">
                            <option value="">-- All Courses --</option>
                        </select>
                    </div>

                    <!-- Semester -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Semester
                        </label>

                        <select name="semesterId"
                                class="form-select"
                                asp-items="ViewBag.Semesters">
                            <option value="">-- All Semesters --</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Filter
                    </button>

                    <a asp-action="ClassSchedules"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- Schedule List -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Course</th>
                                <th>Teacher</th>
                                <th>Semester</th>
                                <th>Day</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Room</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        @item.Course?.CourseName
                                    </td>

                                    <td>
                                        @item.Teacher?.Name
                                    </td>

                                    <td>
                                        @item.Semester?.SemesterName
                                    </td>

                                    <td>
                                        @item.DayOfWeek
                                    </td>

                                    <td>
                                        @item.StartTime
                                    </td>

                                    <td>
                                        @item.EndTime
                                    </td>

                                    <td>
                                        @item.Room
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <a asp-action="EditClassSchedule"
                                               asp-route-id="@item.ClassScheduleId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <a asp-action="DeleteClassSchedule"
                                               asp-route-id="@item.ClassScheduleId"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No class schedules found.
                </div>
            }

        </div>

    </div>

</div>