@model List<StudentManagementSystem.Models.Assignment>

@{
    ViewData["Title"] = "Assignment Monitoring";
}

<div class="container mt-4">
    <h1 class="fw-bold">Assignment Monitoring</h1>
    <p class="text-muted">View-only across all teachers. Assignment content can only be edited by its own teacher.</p>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="teacherId" asp-items="ViewBag.Teachers" class="form-select" onchange="this.form.submit()">
                <option value="">All Teachers</option>
            </select>
        </div>
        <div class="col-auto">
            <select name="courseId" asp-items="ViewBag.Courses" class="form-select" onchange="this.form.submit()">
                <option value="">All Courses</option>
            </select>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No assignments found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Course</th>
                        <th>Teacher</th>
                        <th>Due Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Course?.CourseName</td>
                            <td>@a.Teacher?.Name</td>
                            <td>@a.DueDate.ToString("MMM dd, yyyy h:mm tt")</td>
                            <td>
                                <a asp-action="AssignmentDetails" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
