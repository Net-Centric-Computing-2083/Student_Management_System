@model List<StudentManagementSystem.Models.Teacher>

@{
    ViewData["Title"] = "Teacher Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Teacher Management</h2>
            <p class="text-muted mb-0">Manage all teacher records</p>
        </div>
        <a asp-action="CreateTeacher" class="btn btn-primary">+ Add Teacher</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Teachers" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Search</label>
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]"
                               class="form-control" placeholder="Name, Email, or Phone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Department</label>
                        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">&nbsp;</label>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Teachers"
                               asp-route-sortOrder="@ViewData["NameSort"]"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-departmentId="@ViewData["CurrentDepartment"]"
                               class="text-white text-decoration-none">Name ↕</a>
                        </th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Department</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">No teachers found.</td></tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@t.Name</td>
                            <td>@t.Email</td>
                            <td>@t.Phone</td>
                            <td>@t.Department?.DepartmentName</td>
                            <td class="text-center">
                                <a asp-action="TeacherDetails" asp-route-id="@t.TeacherId" class="btn btn-info btn-sm text-white">Details</a>
                                <a asp-action="EditTeacher" asp-route-id="@t.TeacherId" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="DeleteTeacher" asp-route-id="@t.TeacherId" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Teachers" asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">Previous</a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Teachers" asp-route-page="@i"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
                </li>
            }
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Teachers" asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-departmentId="@ViewData["CurrentDepartment"]"
                       asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
                </li>
            }
        </ul>
    </nav>

</div>
