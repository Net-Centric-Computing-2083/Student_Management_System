@model StudentManagementSystem.Models.Semester

@{
    ViewData["Title"] = "New Semester";
}

<div class="container mt-4">
    <h1 class="fw-bold">New Semester</h1>

    <form asp-action="CreateSemester" method="post" style="max-width:500px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Academic Year</label>
            <input asp-for="AcademicYear" class="form-control" placeholder="e.g. 2026/2027" />
            <span asp-validation-for="AcademicYear" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Semester Name</label>
            <input asp-for="SemesterName" class="form-control" placeholder="e.g. Fall / Spring / Semester 1" />
            <span asp-validation-for="SemesterName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Semesters" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
