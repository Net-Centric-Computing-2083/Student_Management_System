@model Student_Management_System.Models.ApplicationUser

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h1 class="fw-bold">My Profile</h1>

    <div class="card shadow-sm mt-3" style="max-width:600px;">
        <div class="card-body">
            <form asp-action="Profile" method="post">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="FullName" class="form-control" value="@Model.FullName" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" disabled />
                    <div class="form-text">Email/username cannot be changed here.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>
        </div>
    </div>
</div>
