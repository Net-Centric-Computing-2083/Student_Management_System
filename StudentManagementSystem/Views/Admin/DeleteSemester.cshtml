@model StudentManagementSystem.Models.Semester

@{
    ViewData["Title"] = "Delete Semester";
}

<div class="container mt-4">
    <h1 class="fw-bold text-danger">Delete Semester</h1>

    <div class="card shadow-sm" style="max-width:500px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">Academic Year</dt>
                <dd class="col-sm-7">@Model.AcademicYear</dd>

                <dt class="col-sm-5">Semester</dt>
                <dd class="col-sm-7">@Model.SemesterName</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeleteSemester" asp-route-id="@Model.SemesterId" method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Semesters" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
