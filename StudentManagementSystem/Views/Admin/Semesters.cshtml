@model List<StudentManagementSystem.Models.Semester>

@{
    ViewData["Title"] = "System Settings - Semesters";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold mb-0">System Settings</h1>
            <p class="text-muted mb-0">Manage academic years and semesters.</p>
        </div>
        <a asp-action="CreateSemester" class="btn btn-primary">+ New Semester</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No semesters configured yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Academic Year</th><th>Semester</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.AcademicYear</td>
                            <td>@s.SemesterName</td>
                            <td>
                                <a asp-action="EditSemester" asp-route-id="@s.SemesterId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="DeleteSemester" asp-route-id="@s.SemesterId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
