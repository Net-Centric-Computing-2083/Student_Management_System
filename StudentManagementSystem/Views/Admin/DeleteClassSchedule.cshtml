@model StudentManagementSystem.Models.ClassSchedule

@{
    ViewData["Title"] = "Delete Class Schedule Entry";
}

<div class="container mt-4">
    <h1 class="fw-bold text-danger">Delete Class Schedule Entry</h1>

    <div class="card shadow-sm" style="max-width:600px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Course</dt>
                <dd class="col-sm-8">@Model.Course?.CourseName</dd>

                <dt class="col-sm-4">Teacher</dt>
                <dd class="col-sm-8">@Model.Teacher?.Name</dd>

                <dt class="col-sm-4">Semester</dt>
                <dd class="col-sm-8">@Model.Semester?.SemesterName (@Model.Semester?.AcademicYear)</dd>

                <dt class="col-sm-4">Day / Time</dt>
                <dd class="col-sm-8">@Model.DayOfWeek, @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</dd>

                <dt class="col-sm-4">Room</dt>
                <dd class="col-sm-8">@Model.Room</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeleteClassSchedule" asp-route-id="@Model.ClassScheduleId" method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="ClassSchedules" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
