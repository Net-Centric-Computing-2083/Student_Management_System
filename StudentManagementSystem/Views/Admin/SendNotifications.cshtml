@{
    ViewData["Title"] = "Send Notification";
}

<div class="container mt-4">
    <h1 class="fw-bold">Send Notification</h1>
    <p class="text-muted">Send a notification to a group of users.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="SendNotifications" method="post" style="max-width:600px;">
        <div class="mb-3">
            <label class="form-label">Send To</label>
            <select name="Target" id="targetSelect" class="form-select" onchange="document.getElementById('courseRow').style.display = this.value === 'Course' ? '' : 'none';">
                <option value="All">Everyone</option>
                <option value="Students">All Students</option>
                <option value="Teachers">All Teachers</option>
                <option value="Course">Students in a Specific Course</option>
            </select>
        </div>

        <div class="mb-3" id="courseRow" style="display:none;">
            <label class="form-label">Course</label>
            <select name="CourseId" asp-items="ViewBag.Courses" class="form-select">
                <option value="">-- Select a course --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Title</label>
            <input name="Title" type="text" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="Message" class="form-control" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Send Notification</button>
    </form>
</div>
