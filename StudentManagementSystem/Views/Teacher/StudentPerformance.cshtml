@model List<StudentManagementSystem.ViewModels.TeacherStudentPerformanceViewModel>

@{
    ViewData["Title"] = "Student Performance";
}

<div class="container mt-4">
    <h1 class="fw-bold">Student Performance</h1>
    <p class="text-muted">Grades, attendance, and assignment activity for students in your courses.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No students found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Registration No.</th>
                        <th>Attendance</th>
                        <th>Average GPA</th>
                        <th>Assignments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Student.Name</td>
                            <td>@p.Student.RegistrationNumber</td>
                            <td>@p.AttendancePercentage.ToString("0.0")%</td>
                            <td>@p.AverageGPA.ToString("0.00")</td>
                            <td>@p.AssignmentsSubmitted / @p.TotalAssignments submitted</td>
                            <td>
                                <a asp-action="StudentPerformanceDetails" asp-route-id="@p.Student.StudentId"
                                   class="btn btn-sm btn-outline-primary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
