@model StudentManagementSystem.Models.Result

@{
    ViewData["Title"] = "Delete Result";
}

<h1>Delete Result</h1>

<h3>Are you sure you want to delete this result?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.Student?.Name</dd>

    <dt class="col-sm-3">Course</dt>
    <dd class="col-sm-9">@Model.Course?.CourseName</dd>

    <dt class="col-sm-3">Total Marks</dt>
    <dd class="col-sm-9">@Model.TotalMarks</dd>

    <dt class="col-sm-3">Grade</dt>
    <dd class="col-sm-9">@Model.Grade</dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="ResultId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>