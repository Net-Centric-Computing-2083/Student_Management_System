@model StudentManagementSystem.Models.Result

@{
    ViewData["Title"] = "Delete Result";
}

<h1>Delete Result</h1>

<h3>Are you sure you want to delete this result?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Student
    </dt>
    <dd class="col-sm-9">
        @Model.Student?.Name
    </dd>

    <dt class="col-sm-3">
        Course
    </dt>
    <dd class="col-sm-9">
        @Model.Course?.CourseName
    </dd>

    <dt class="col-sm-3">
        Marks
    </dt>
    <dd class="col-sm-9">
        @Model.Marks
    </dd>

    <dt class="col-sm-3">
        Grade
    </dt>
    <dd class="col-sm-9">
        @Model.Grade
    </dd>

    <dt class="col-sm-3">
        Result Date
    </dt>
    <dd class="col-sm-9">
        @Model.ResultDate.ToString("yyyy-MM-dd")
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="ResultId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>