@model StudentManagementSystem.Models.Result

@{
    ViewData["Title"] = "Edit Result";
}

<h1>Edit Result</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ResultId" />

            <div class="form-group mb-3">
                <label asp-for="StudentId"></label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CourseId"></label>
                <select asp-for="CourseId" class="form-control" asp-items="ViewBag.CourseId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="InternalMarks"></label>
                <input asp-for="InternalMarks" class="form-control" />
                <span asp-validation-for="InternalMarks" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PracticalMarks"></label>
                <input asp-for="PracticalMarks" class="form-control" />
                <span asp-validation-for="PracticalMarks" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FinalMarks"></label>
                <input asp-for="FinalMarks" class="form-control" />
                <span asp-validation-for="FinalMarks" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Grade" class="control-label"></label>
                <input asp-for="Grade" class="form-control" readonly />
                <small class="text-muted">Grade is calculated automatically from total marks.</small>
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResultDate"></label>
                <input asp-for="ResultDate" type="date" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}